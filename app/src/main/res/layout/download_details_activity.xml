<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/download_details_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:dialogPreferredPadding"
        android:paddingTop="12dp"
        android:paddingEnd="?android:dialogPreferredPadding"
        android:paddingBottom="12dp"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/download_details_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="?android:dialogPreferredPadding"
        android:paddingEnd="?android:dialogPreferredPadding"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/download_details_downloaded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:dialogPreferredPadding"
        android:paddingEnd="?android:dialogPreferredPadding"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/download_details_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:dialogPreferredPadding"
        android:paddingEnd="?android:dialogPreferredPadding"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/download_details_average_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:dialogPreferredPadding"
        android:paddingEnd="?android:dialogPreferredPadding"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/download_details_elapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?android:dialogPreferredPadding"
        android:paddingEnd="?android:dialogPreferredPadding"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/download_details_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="?android:dialogPreferredPadding"
        android:text="@android:string/ok" />

</LinearLayout>
